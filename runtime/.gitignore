# Locked jars are downloaded locally by fetch scripts and must not be committed.
server/*.jar
server/*.jar.part
plugins/*.jar
plugins/*.jar.part

# Disposable smoke runs and server output.
test-data/
logs/
*.log
profiles/*.jfr

# Folia-generated worlds are local runtime state.
world/
world_nether/
world_the_end/
*/world/
*/world_nether/
*/world_the_end/

# Python runtime helpers do not require generated bytecode in the repository.
__pycache__/
*.py[cod]
